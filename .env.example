# AWCP — Environment Variables Template
# Copy to .env and fill in values.
#
# ── Database ──────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/awcp
# REDIS_URL=redis://localhost:6379/0
#
# ── Temporal ──────────────────────────────
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_NAMESPACE=awcp
# TEMPORAL_TASK_QUEUE=awcp-main
#
# ── OPA ───────────────────────────────────
# OPA_URL=http://localhost:8181
#
# ── LLM Providers ────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# ── Feature Flags ────────────────────────
# FLIPT_URL=http://localhost:8080
#
# ── Observability ────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#
# ── Modal (Sandbox) ──────────────────────
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
